# =============================================================================
# VIGILO (servizio: asset-frontend) — Variabili d'ambiente (template)
# =============================================================================
# Copiare in .env.development / .env.production e valorizzare.
# Tutte le variabili esposte al client DEVONO avere il prefisso VITE_.
# =============================================================================

# Versione applicativa mostrata in UI (VersionInfo)
VITE_APP_VERSION=0.1.0-dev

# Base URL delle API.
# Lasciare VUOTE per usare URL relativi: in sviluppo passano dal proxy di Vite
# (vite.config.ts), in produzione dal reverse proxy che serve la SPA.
# Valorizzarle solo per puntare direttamente al gateway (richiede CORS lato gateway).
VITE_API_URL=
VITE_API_BASE_URL=

# Log service. In sviluppo /log-api viene riscritto dal proxy sul target sottostante.
VITE_LOG_SERVICE_URL=/log-api
VITE_LOG_SERVICE_API_KEY=

# Destinazioni del proxy di sviluppo (opzionali, questi sono i default)
# VITE_PROXY_TARGET=http://localhost
# VITE_PROXY_LOG_TARGET=http://localhost:4001

# Ambiente e logging
VITE_MODE=development
VITE_LOG_LEVEL=debug

# Feature flags
VITE_ENABLE_DEBUG_TOOLS=true
VITE_ENABLE_MOCKING=false
